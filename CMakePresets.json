{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-hosted",
      "displayName": "ClasSICK 0.97 Windows core and surface viewer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-hosted",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "${sourceDir}/.tools/llvm-mingw/llvm-mingw-20260908-ucrt-x86_64/bin/clang.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [ { "name": "windows-hosted", "configurePreset": "windows-hosted" } ],
  "testPresets": [
    {
      "name": "windows-hosted",
      "configurePreset": "windows-hosted",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
